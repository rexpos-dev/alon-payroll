# Copy this file to ".env" and change the values.

# Web server
PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-text

# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/alon_payroll"

# First admin account (used by "npm run migrate" only when there are no users yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
