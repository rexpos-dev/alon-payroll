<%- include('../partials/header') %>
<div class="page-head">
  <h1>Employees</h1>
  <div class="actions">
    <% if (can('hr')) { %>
      <a class="btn" href="/employees/import">Import from Excel</a>
      <a class="btn primary" href="/employees/new">New employee</a>
    <% } %>
  </div>
</div>
<form class="filters" method="get">
  <input name="q" value="<%= q %>" placeholder="Search: Emp No or name">
  <select name="status">
    <% for (const s of ['Active', 'Inactive', 'Resigned', 'all']) { %>
      <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s === 'all' ? 'All' : s %></option>
    <% } %>
  </select>
  <button class="btn">Search</button>
</form>
<div class="card flush">
<table class="grid">
  <thead><tr><th>Emp No</th><th>Name</th><th>Department</th><th>Position</th><th>Pay type</th><th class="num">Rate</th><th>Tax</th><th>Status</th></tr></thead>
  <tbody>
  <% for (const e of rows) { %>
    <tr>
      <td><%= e.emp_no %></td>
      <td><a href="/employees/<%= e.id %>/edit"><%= e.last_name %>, <%= e.first_name %> <%= e.middle_name ? e.middle_name[0] + '.' : '' %></a></td>
      <td><%= e.department || '' %></td>
      <td><%= e.position || '' %></td>
      <td><%= e.pay_type === 'semi' ? 'Semi-monthly' : 'Daily' %></td>
      <td class="num"><%= e.pay_type === 'semi' ? '₱' + money(e.monthly_basic) + ' /mo' : '₱' + money(e.daily_rate) + ' /day' %></td>
      <td><%= e.tax_class === 'mwe' ? 'MWE' : 'Above-min' %></td>
      <td><span class="pill <%= e.status === 'Active' ? 'approved' : 'draft' %>"><%= e.status %></span></td>
    </tr>
  <% } %>
  <% if (!rows.length) { %><tr><td colspan="8" class="muted center">No employees found.</td></tr><% } %>
  </tbody>
</table>
</div>
<p class="muted"><%= rows.length %> employee(s)</p>
<%- include('../partials/footer') %>
