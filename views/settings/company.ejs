<%- include('../partials/header') %>
<div class="page-head"><h1>Company Settings</h1></div>
<form method="post" action="/settings/company" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Company</h2>
  <div class="form-grid">
    <label class="wide">Company name<input name="name" value="<%= company.name %>"></label>
    <label class="wide">Address<input name="address" value="<%= company.address || '' %>"></label>
    <label>Contact<input name="contact" value="<%= company.contact || '' %>"></label>
  </div>
  <h2>Payslip signatories</h2>
  <div class="form-grid">
    <label>Prepared by<input name="prepared_by" value="<%= company.prepared_by || '' %>"></label>
    <label>Checked by<input name="checked_by" value="<%= company.checked_by || '' %>"></label>
    <label>Approved by<input name="approved_by" value="<%= company.approved_by || '' %>"></label>
  </div>
  <h2>When to deduct SSS, PhilHealth and Pag-IBIG</h2>
  <div class="checks vertical">
    <label><input type="radio" name="contrib_mode" value="split" <%= company.contrib_mode === 'split' ? 'checked' : '' %>> Split across both cut-offs (1st and 2nd)</label>
    <label><input type="radio" name="contrib_mode" value="first" <%= company.contrib_mode === 'first' ? 'checked' : '' %>> All on the 1st cut-off</label>
    <label><input type="radio" name="contrib_mode" value="second" <%= company.contrib_mode === 'second' ? 'checked' : '' %>> All on the 2nd cut-off</label>
  </div>
  <div class="form-actions"><button class="btn primary">Save</button></div>
</form>

<form method="post" action="/settings/premiums" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>OT and holiday multipliers</h2>
  <div class="form-grid compact">
    <% for (const p of premiums) { %><label><%= p.label %><input type="number" step="0.0001" min="0" name="p_<%= p.code %>" value="<%= Number(p.multiplier) %>"></label><% } %>
  </div>
  <p class="muted">Regular OT = hourly × OT. Rest day/holiday OT = hourly × day multiplier × "holiday OT multiplier". Night diff = hourly × ND rate per hour (22:00–06:00). For semi-monthly pay, holiday work adds (multiplier − 1) because the day is already included in the monthly basic.</p>
  <div class="form-actions"><button class="btn primary">Save multipliers</button></div>
</form>
<%- include('../partials/footer') %>
