<%- include('../partials/header') %>
<div class="page-head">
  <h1>Audit Log</h1>
  <form method="get" class="filters">
    <select name="entity" onchange="this.form.submit()"><option value="">All</option><% for (const e of entities) { %><option <%= e.entity === entity ? 'selected' : '' %>><%= e.entity %></option><% } %></select>
  </form>
</div>
<div class="card flush">
<table class="grid small">
  <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Record</th><th>Details</th></tr></thead>
  <tbody>
  <% for (const a of rows) { %>
    <tr><td class="nowrap"><%= a.created_at %></td><td><%= a.username || '—' %></td><td><%= a.action %></td><td><%= a.entity %><%= a.entity_id ? ' #' + a.entity_id : '' %></td><td class="details"><%= a.details || '' %></td></tr>
  <% } %>
  <% if (!rows.length) { %><tr><td colspan="5" class="muted center">No records.</td></tr><% } %>
  </tbody>
</table>
</div>
<div class="actions">
  <% if (page > 1) { %><a class="btn" href="?entity=<%= entity %>&page=<%= page - 1 %>">‹ Newer</a><% } %>
  <% if (rows.length === 100) { %><a class="btn" href="?entity=<%= entity %>&page=<%= page + 1 %>">Older ›</a><% } %>
</div>
<%- include('../partials/footer') %>
