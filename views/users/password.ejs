<%- include('../partials/header') %>
<div class="page-head"><h1>Change password</h1></div>
<form method="post" action="/account/password" class="card narrow stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Current password<input type="password" name="current" required autocomplete="current-password"></label>
  <label>New password (8+ characters)<input type="password" name="next1" minlength="8" required autocomplete="new-password"></label>
  <label>Retype new password<input type="password" name="next2" minlength="8" required autocomplete="new-password"></label>
  <button class="btn primary">Save</button>
</form>
<%- include('../partials/footer') %>
