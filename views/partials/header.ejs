<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Alon Payroll</title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
<% if (user) { %>
<div class="shell">
  <aside class="side">
    <div class="brand">
      <div class="brand-mark">A</div>
      <div>
        <div class="brand-name">Alon Payroll</div>
        <div class="brand-co"><%= companyName %></div>
      </div>
    </div>
    <nav>
      <% const nav = (href, label) => `<a href="${href}" class="${(href === '/' ? path === '/' : path.startsWith(href)) ? 'on' : ''}">${label}</a>`; %>
      <div class="nav-group">Payroll</div>
      <%- nav('/', 'Dashboard') %>
      <%- nav('/periods', 'Payroll Periods') %>
      <%- nav('/dtr', 'Daily Time Record') %>
      <%- nav('/loans', 'Loans') %>
      <div class="nav-group">Masterdata</div>
      <%- nav('/employees', 'Employees') %>
      <%- nav('/holidays', 'Holidays') %>
      <% if (can('hr')) { %><%- nav('/settings/lists', 'Departments') %><% } %>
      <% if (can()) { %>
      <div class="nav-group">Admin</div>
      <%- nav('/settings/pay-items', 'Allowances & Deductions') %>
      <%- nav('/settings/rates', 'Government Rates') %>
      <a href="/settings" class="<%= path === '/settings' ? 'on' : '' %>">Company Settings</a>
      <%- nav('/users', 'Users') %>
      <% } %>
      <% if (can('approver')) { %><%- nav('/audit', 'Audit Log') %><% } %>
    </nav>
    <div class="side-user">
      <div><strong><%= user.full_name %></strong></div>
      <div class="muted"><%= ROLE_LABELS[user.role] %></div>
      <div class="side-links">
        <a href="/account/password">Password</a>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn">Logout</button></form>
      </div>
    </div>
  </aside>
  <main class="main">
<% } else { %>
<main class="main solo">
<% } %>
    <% const trail = crumbs(title); if (trail.length) { %>
    <nav class="crumbs" aria-label="Breadcrumb">
      <% trail.forEach((c, i) => { %>
        <% if (i) { %><span class="sep">/</span><% } %>
        <% if (c.href) { %><a href="<%= c.href %>"><%= c.label %></a><% } else { %><span class="cur" aria-current="page"><%= c.label %></span><% } %>
      <% }) %>
    </nav>
    <% } %>
    <% for (const f of flash) { %>
      <div class="flash <%= f.type %>"><%= f.message %></div>
    <% } %>
