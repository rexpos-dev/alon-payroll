<%- include('../partials/header') %>
<div class="page-head"><h1><%= loan.loan_type %> Loan · <%= loan.last_name %>, <%= loan.first_name %></h1><a class="btn" href="/loans">Back</a></div>
<div class="two-col">
<form method="post" action="/loans/<%= loan.id %>" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <table class="grid small">
    <tr><td>Reference</td><td><%= loan.reference_no || '—' %></td></tr>
    <tr><td>Principal</td><td>₱<%= money(loan.principal) %></td></tr>
    <tr><td>Start</td><td><%= fmtDate(loan.start_date) %></td></tr>
  </table>
  <div class="form-grid compact">
    <label>Amortization<input type="number" step="0.01" min="0" name="amortization" value="<%= loan.amortization %>" <%= can('hr','payroll') ? '' : 'disabled' %>></label>
    <label>Balance<input type="number" step="0.01" min="0" name="balance" value="<%= loan.balance %>" <%= can('hr','payroll') ? '' : 'disabled' %>></label>
    <label>Status<select name="status" <%= can('hr','payroll') ? '' : 'disabled' %>><% for (const s of ['active','paid','cancelled']) { %><option <%= loan.status === s ? 'selected' : '' %>><%= s %></option><% } %></select></label>
    <label class="wide">Notes<input name="notes" value="<%= loan.notes || '' %>" <%= can('hr','payroll') ? '' : 'disabled' %>></label>
  </div>
  <% if (can('hr','payroll')) { %><div class="form-actions"><button class="btn primary">Save</button></div><% } %>
</form>
<div class="card">
  <h2>Payments</h2>
  <table class="grid small">
    <thead><tr><th>Pay date</th><th>Cut-off</th><th class="num">Amount</th></tr></thead>
    <tbody>
      <% for (const p of payments) { %><tr><td><%= fmtDate(p.pay_date) %></td><td><%= fmtDate(p.date_from) %> – <%= fmtDate(p.date_to) %></td><td class="num"><%= money(p.amount) %></td></tr><% } %>
      <% if (!payments.length) { %><tr><td colspan="3" class="muted center">No posted payments yet.</td></tr><% } %>
    </tbody>
  </table>
  <p class="muted">Payments are recorded when the payroll period is posted.</p>
</div>
</div>
<%- include('../partials/footer') %>
